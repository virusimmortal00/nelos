{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/virusimmortal00/nelos/validation/proxmox-desktop/v1/golden-builder-host-install-plan.schema.json",
  "title": "Nelos golden-builder Proxmox host installation plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["helperDigest", "helperPath", "hostBindingDigest", "hostBindingPath", "kind", "knownHostsLine", "planDigest", "principals", "schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "nelos-golden-builder-host-install-plan" },
    "hostBindingDigest": { "$ref": "#/$defs/sha256" },
    "hostBindingPath": { "const": "/etc/nelos-golden/builder-host-binding.json" },
    "helperDigest": { "$ref": "#/$defs/sha256" },
    "helperPath": { "const": "/usr/libexec/nelos-proxmox-golden-builder-helper" },
    "knownHostsLine": { "type": "string", "pattern": "^192\\.168\\.1\\.110 ssh-ed25519 [A-Za-z0-9+/]+={0,2}\\n$", "maxLength": 4096 },
    "principals": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [
        { "$ref": "#/$defs/provider" },
        { "$ref": "#/$defs/attestor" }
      ],
      "items": false
    },
    "planDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "principal": {
      "type": "object", "additionalProperties": false,
      "required": ["authorizedKey", "authorizedKeysPath", "home", "role", "shell", "sudoers", "sudoersPath", "user"],
      "properties": {
        "role": { "enum": ["provider", "attestor"] }, "user": { "type": "string" }, "home": { "type": "string" }, "shell": { "const": "/bin/sh" },
        "authorizedKeysPath": { "type": "string" }, "authorizedKey": { "type": "string", "maxLength": 8192 },
        "sudoersPath": { "type": "string" }, "sudoers": { "type": "string", "maxLength": 4096 }
      }
    },
    "provider": { "allOf": [{ "$ref": "#/$defs/principal" }, { "properties": { "role": { "const": "provider" }, "user": { "const": "nelos-golden-provider" }, "home": { "const": "/var/lib/nelos-golden-provider" }, "authorizedKeysPath": { "const": "/var/lib/nelos-golden-provider/.ssh/authorized_keys" }, "sudoersPath": { "const": "/etc/sudoers.d/nelos-golden-builder-provider" } } }] },
    "attestor": { "allOf": [{ "$ref": "#/$defs/principal" }, { "properties": { "role": { "const": "attestor" }, "user": { "const": "nelos-golden-attestor" }, "home": { "const": "/var/lib/nelos-golden-attestor" }, "authorizedKeysPath": { "const": "/var/lib/nelos-golden-attestor/.ssh/authorized_keys" }, "sudoersPath": { "const": "/etc/sudoers.d/nelos-golden-builder-attestor" } } }] }
  }
}
