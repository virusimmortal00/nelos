{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/virusimmortal00/nelos/validation/proxmox-desktop/v1/golden-builder-request.schema.json",
  "title": "Nelos Proxmox golden-builder reservation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiTlsCaDigest",
    "apiUrl",
    "attestorTokenId",
    "buildNonce",
    "buildTokenId",
    "cleanupExpiresAt",
    "expiresAt",
    "maxBuildMs",
    "networkAclPath",
    "node",
    "outputTemplate",
    "providerId",
    "reservationId",
    "schemaVersion",
    "sourceCommit",
    "sourceTemplateName",
    "storage",
    "volumeAttestor"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reservationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "providerId": { "const": "proxmox-lab" },
    "apiUrl": { "const": "https://192.168.1.110:8006/api2/json" },
    "apiTlsCaDigest": { "const": "sha256:04eccf7506f3f0de1fe2949aea667ce8fdc48f0ce33fcf758b05d1596739964d" },
    "node": { "const": "prox2" },
    "storage": { "const": "local-lvm" },
    "networkAclPath": { "const": "/sdn/zones/nelosbld/nelosbld" },
    "sourceCommit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "sourceTemplateName": { "const": "nelos-ubuntu-24-04-source" },
    "outputTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["macAddress", "name", "vmId"],
      "properties": {
        "macAddress": { "const": "02:4E:45:4C:90:27" },
        "name": { "const": "nelos-desktop-ubuntu-24-04-v1" },
        "vmId": { "const": 9027 }
      }
    },
    "buildNonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "buildTokenId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+@[A-Za-z0-9._-]+![A-Za-z0-9._-]+$" },
    "attestorTokenId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+@[A-Za-z0-9._-]+![A-Za-z0-9._-]+$" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "cleanupExpiresAt": { "type": "string", "format": "date-time" },
    "maxBuildMs": { "type": "integer", "minimum": 300000, "maximum": 7200000 },
    "volumeAttestor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["helperDigest", "hostKeyFingerprint", "identityFingerprint", "sshHost", "sshPort", "sshUser"],
      "properties": {
        "helperDigest": { "$ref": "#/$defs/sha256" },
        "hostKeyFingerprint": { "const": "SHA256:/7TgXiGHrARF8+hFiOuUGlC/mrRFheILcEKs6FiANzg" },
        "identityFingerprint": { "$ref": "#/$defs/sshFingerprint" },
        "sshHost": { "const": "192.168.1.110" },
        "sshPort": { "const": 22 },
        "sshUser": { "const": "nelosmeasure" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sshFingerprint": { "type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$" }
  }
}
