{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nelos.dev/contracts/desktop-certification/receipt.v1.schema.json",
  "title": "Nelos Desktop certification receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "nelosCommitSha", "candidateDigest", "harnessCommitSha", "harnessVersion", "templateIdentity", "evidenceIdentity", "scenarioTotals", "assertionTotals", "scenarios", "assertions", "cleanup"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "nelos-desktop-certification-v1" },
    "nelosCommitSha": { "$ref": "#/$defs/commitSha" },
    "candidateDigest": { "$ref": "#/$defs/digest" },
    "harnessCommitSha": { "$ref": "#/$defs/commitSha" },
    "harnessVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "templateIdentity": { "$ref": "#/$defs/digest" },
    "evidenceIdentity": { "$ref": "#/$defs/digest" },
    "scenarioTotals": { "$ref": "#/$defs/scenarioTotals" },
    "assertionTotals": { "$ref": "#/$defs/totals" },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "scenario-result.v1.schema.json" } },
    "assertions": { "type": "array", "items": { "$ref": "assertion-result.v1.schema.json" } },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "destroyed", "absent", "independentlyVerified"],
      "properties": {
        "state": { "const": "verified" },
        "destroyed": { "const": true },
        "absent": { "const": true },
        "independentlyVerified": { "const": true }
      }
    }
  },
  "$defs": {
    "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "scenarioTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "skipped"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
