{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nelos.dev/contracts/desktop-certification/assertion-result.v1.schema.json",
  "title": "Nelos Desktop certification assertion result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assertionId", "scenarioId", "outcome", "code"],
  "properties": {
    "assertionId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "scenarioId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "outcome": { "enum": ["passed", "failed"] },
    "code": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
  }
}
