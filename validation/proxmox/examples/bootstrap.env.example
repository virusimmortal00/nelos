# Review before use. Keep the populated copy outside the repository.
# Run the bootstrap script only on the selected Proxmox VE 8.4 node as root.

export PROXMOX_NODE="<pve-node-name>"
export BASE_TEMPLATE_VMID="<unused-cluster-wide-vmid>"
export BASE_TEMPLATE_NAME="<unique-base-template-name>"

export PVE_VM_STORAGE="<node-local-images-storage-id>"
export PVE_EFI_STORAGE="<node-local-images-storage-id>"
export PVE_CLOUD_INIT_STORAGE="<node-local-images-storage-id>"
export PVE_SNIPPETS_STORAGE="<node-local-dir-storage-with-snippets>"

# Optional; the default is /var/tmp/nelos-validator-images.
# export IMAGE_CACHE_DIR="<absolute-node-local-cache-directory>"
