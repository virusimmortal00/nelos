# Review before use. Keep the populated copy outside the repository and export
# these values only in the dedicated Linux controller process.

export NELOS_PACKER_STATE_DIR="<absolute-state-directory-outside-checkout>"

export PROXMOX_URL="https://<certificate-hostname>:8006/api2/json"
export PROXMOX_USERNAME="<user-at-realm-exclamation-token-id>"
# Inject this separately from a secret store; never save the real value here.
# export PROXMOX_TOKEN="<secret-token-value>"

export PKR_VAR_proxmox_node="<pve-node-name>"
export PKR_VAR_proxmox_pool="<dedicated-validator-pool-or-empty>"
export PKR_VAR_base_template_vmid="<existing-base-template-vmid>"
export PKR_VAR_base_template_name="<exact-base-template-name>"
export PKR_VAR_output_template_vmid="<unused-validator-template-vmid>"
export PKR_VAR_output_template_name="<unique-validator-template-name>"
export PKR_VAR_cloud_init_storage="<node-local-images-storage-id>"
