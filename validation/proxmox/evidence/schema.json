{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nelos:proxmox-validator:evidence:v1",
  "title": "Nelos Proxmox Validator Evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractVersion",
    "runId",
    "candidate",
    "template",
    "lanes",
    "sanitization",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contractVersion": {
      "$ref": "#/$defs/semver"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "candidate": {
      "type": "object",
      "required": [
        "sourceRevision",
        "treeSha256",
        "dirty"
      ],
      "properties": {
        "sourceRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "treeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "dirty": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "template": {
      "type": "object",
      "required": [
        "templateVersion",
        "proxmoxVeVersion",
        "operatingSystem",
        "architecture",
        "contractSha256",
        "toolchainLockSha256"
      ],
      "properties": {
        "templateVersion": {
          "$ref": "#/$defs/semver"
        },
        "proxmoxVeVersion": {
          "const": "8.4"
        },
        "operatingSystem": {
          "const": "ubuntu-24.04-lts"
        },
        "architecture": {
          "const": "x86_64"
        },
        "contractSha256": {
          "$ref": "#/$defs/sha256"
        },
        "toolchainLockSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "lanes": {
      "type": "object",
      "required": [
        "legacy-01446",
        "agent-plugin-01470"
      ],
      "properties": {
        "legacy-01446": {
          "$ref": "#/$defs/legacyLaneEvidence"
        },
        "agent-plugin-01470": {
          "$ref": "#/$defs/agentPluginLaneEvidence"
        }
      },
      "additionalProperties": false
    },
    "sanitization": {
      "type": "object",
      "required": [
        "status",
        "redactionsApplied",
        "credentialsCaptured",
        "fullEnvironmentCaptured",
        "fullConfigurationCaptured",
        "userSpecificIdentifiersCaptured",
        "macStateCaptured"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "redactionsApplied": {
          "const": true
        },
        "credentialsCaptured": {
          "const": false
        },
        "fullEnvironmentCaptured": {
          "const": false
        },
        "fullConfigurationCaptured": {
          "const": false
        },
        "userSpecificIdentifiersCaptured": {
          "const": false
        },
        "macStateCaptured": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "status",
        "failures"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*){1,4}$",
            "maxLength": 160
          },
          "maxItems": 100
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checkResults": {
      "type": "object",
      "required": [
        "marketplaceInstall",
        "pluginInstall",
        "freshProcessStart",
        "mcpInitialize",
        "toolsList",
        "nelosConfigGet",
        "laneParity"
      ],
      "properties": {
        "marketplaceInstall": {
          "type": "boolean"
        },
        "pluginInstall": {
          "type": "boolean"
        },
        "freshProcessStart": {
          "type": "boolean"
        },
        "mcpInitialize": {
          "type": "boolean"
        },
        "toolsList": {
          "type": "boolean"
        },
        "nelosConfigGet": {
          "type": "boolean"
        },
        "laneParity": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "legacyLaneEvidence": {
      "type": "object",
      "required": [
        "codexVersion",
        "freshProcess",
        "home",
        "codexHome",
        "pluginVersion",
        "pluginManifestPath",
        "mcpManifestPath",
        "launchMode",
        "processObservation",
        "toolNames",
        "checks"
      ],
      "properties": {
        "codexVersion": {
          "const": "0.144.6"
        },
        "freshProcess": {
          "type": "boolean"
        },
        "home": {
          "type": "string",
          "pattern": "^/var/lib/nelos-validator/runs/[A-Za-z0-9._-]+/legacy-01446/home$"
        },
        "codexHome": {
          "type": "string",
          "pattern": "^/var/lib/nelos-validator/runs/[A-Za-z0-9._-]+/legacy-01446/home/\\.codex$"
        },
        "pluginVersion": {
          "$ref": "#/$defs/semver"
        },
        "pluginManifestPath": {
          "const": ".codex-plugin/plugin.json"
        },
        "mcpManifestPath": {
          "const": ".mcp.json"
        },
        "launchMode": {
          "const": "inline-home-cache-bootstrap"
        },
        "processObservation": {
          "type": "object",
          "required": [
            "commandClass",
            "cwdClass",
            "observedEnvironmentKeys",
            "fullCommandCaptured",
            "fullEnvironmentCaptured"
          ],
          "properties": {
            "commandClass": {
              "const": "node-inline-bootstrap"
            },
            "cwdClass": {
              "const": "task-workspace"
            },
            "observedEnvironmentKeys": {
              "type": "array",
              "items": {
                "enum": [
                  "CODEX_HOME",
                  "HOME",
                  "NELOS_PLUGIN_VERSION",
                  "NELOS_RELEASE_BUILD_IDENTITY"
                ]
              },
              "uniqueItems": true
            },
            "fullCommandCaptured": {
              "const": false
            },
            "fullEnvironmentCaptured": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "toolNames": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,127}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "checks": {
          "$ref": "#/$defs/checkResults"
        }
      },
      "additionalProperties": false
    },
    "agentPluginLaneEvidence": {
      "type": "object",
      "required": [
        "codexVersion",
        "freshProcess",
        "home",
        "codexHome",
        "pluginVersion",
        "pluginManifestPath",
        "mcpManifestPath",
        "launchMode",
        "processObservation",
        "toolNames",
        "checks"
      ],
      "properties": {
        "codexVersion": {
          "const": "0.147.0"
        },
        "freshProcess": {
          "type": "boolean"
        },
        "home": {
          "type": "string",
          "pattern": "^/var/lib/nelos-validator/runs/[A-Za-z0-9._-]+/agent-plugin-01470/home$"
        },
        "codexHome": {
          "type": "string",
          "pattern": "^/var/lib/nelos-validator/runs/[A-Za-z0-9._-]+/agent-plugin-01470/home/\\.codex$"
        },
        "pluginVersion": {
          "$ref": "#/$defs/semver"
        },
        "pluginManifestPath": {
          "const": "plugin.json"
        },
        "mcpManifestPath": {
          "const": "mcp.json"
        },
        "launchMode": {
          "const": "direct-plugin-root"
        },
        "processObservation": {
          "type": "object",
          "required": [
            "commandClass",
            "cwdClass",
            "observedEnvironmentKeys",
            "fullCommandCaptured",
            "fullEnvironmentCaptured"
          ],
          "properties": {
            "commandClass": {
              "const": "node-plugin-root-entrypoint"
            },
            "cwdClass": {
              "const": "plugin-root"
            },
            "observedEnvironmentKeys": {
              "type": "array",
              "items": {
                "enum": [
                  "CODEX_HOME",
                  "HOME",
                  "NELOS_PLUGIN_VERSION",
                  "NELOS_RELEASE_BUILD_IDENTITY",
                  "PLUGIN_DATA",
                  "PLUGIN_ROOT"
                ]
              },
              "uniqueItems": true
            },
            "fullCommandCaptured": {
              "const": false
            },
            "fullEnvironmentCaptured": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "toolNames": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,127}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "checks": {
          "$ref": "#/$defs/checkResults"
        }
      },
      "additionalProperties": false
    }
  }
}
