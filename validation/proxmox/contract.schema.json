{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nelos:proxmox-validator:contract:v1",
  "title": "Nelos Proxmox Validator Template Contract",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "contractId",
    "contractVersion",
    "template",
    "scope",
    "hardware",
    "isolation",
    "lanes",
    "validation",
    "retention",
    "release"
  ],
  "properties": {
    "$schema": {
      "const": "./contract.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "contractId": {
      "const": "nelos-proxmox-validator-template"
    },
    "contractVersion": {
      "$ref": "#/$defs/semver"
    },
    "template": {
      "type": "object",
      "required": [
        "name",
        "distributionModel",
        "immutability",
        "cloneLifecycle"
      ],
      "properties": {
        "name": {
          "const": "nelos-validator"
        },
        "distributionModel": {
          "const": "repository-recipe-and-release-manifest"
        },
        "immutability": {
          "const": "versioned-template"
        },
        "cloneLifecycle": {
          "const": "disposable-linked-clone"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "surface",
        "proxmoxVeBaseline",
        "guest",
        "supportedProducts",
        "excludedSurfaces"
      ],
      "properties": {
        "surface": {
          "const": "linux-cli-only"
        },
        "proxmoxVeBaseline": {
          "const": "8.4"
        },
        "guest": {
          "type": "object",
          "required": [
            "operatingSystem",
            "distribution",
            "release",
            "architecture"
          ],
          "properties": {
            "operatingSystem": {
              "const": "linux"
            },
            "distribution": {
              "const": "ubuntu"
            },
            "release": {
              "const": "24.04 LTS"
            },
            "architecture": {
              "const": "x86_64"
            }
          },
          "additionalProperties": false
        },
        "supportedProducts": {
          "type": "array",
          "items": {
            "const": "codex-cli"
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "excludedSurfaces": {
          "type": "array",
          "items": {
            "enum": [
              "arm64",
              "codex-desktop",
              "codex-ide",
              "macos",
              "windows"
            ]
          },
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "hardware": {
      "type": "object",
      "required": [
        "machine",
        "firmware",
        "cpu",
        "memory",
        "disk",
        "network",
        "cloudInit",
        "guestAgent",
        "vmIdPolicy"
      ],
      "properties": {
        "machine": {
          "const": "q35"
        },
        "firmware": {
          "const": "ovmf"
        },
        "cpu": {
          "type": "object",
          "required": [
            "architecture",
            "type",
            "sockets",
            "cores",
            "totalVcpus",
            "numa"
          ],
          "properties": {
            "architecture": {
              "const": "x86_64"
            },
            "type": {
              "const": "x86-64-v2-AES"
            },
            "sockets": {
              "const": 1
            },
            "cores": {
              "const": 4
            },
            "totalVcpus": {
              "const": 4
            },
            "numa": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "memory": {
          "type": "object",
          "required": [
            "sizeMiB",
            "ballooning"
          ],
          "properties": {
            "sizeMiB": {
              "const": 8192
            },
            "ballooning": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "disk": {
          "type": "object",
          "required": [
            "sizeGiB",
            "bus",
            "controller",
            "storageScope",
            "snapshotCapable",
            "discard",
            "ioThread"
          ],
          "properties": {
            "sizeGiB": {
              "const": 64
            },
            "bus": {
              "const": "scsi0"
            },
            "controller": {
              "const": "virtio-scsi-single"
            },
            "storageScope": {
              "const": "node-local"
            },
            "snapshotCapable": {
              "const": true
            },
            "discard": {
              "const": true
            },
            "ioThread": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "required": [
            "interfaces",
            "model",
            "bridge",
            "addressing",
            "firewall"
          ],
          "properties": {
            "interfaces": {
              "const": 1
            },
            "model": {
              "const": "virtio"
            },
            "bridge": {
              "const": "vmbr0"
            },
            "addressing": {
              "const": "dhcp"
            },
            "firewall": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "cloudInit": {
          "const": true
        },
        "guestAgent": {
          "const": true
        },
        "vmIdPolicy": {
          "type": "object",
          "required": [
            "scope",
            "unique",
            "allocation"
          ],
          "properties": {
            "scope": {
              "const": "cluster-wide"
            },
            "unique": {
              "const": true
            },
            "allocation": {
              "const": "external"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "isolation": {
      "type": "object",
      "required": [
        "runRootTemplate",
        "laneRootTemplate",
        "environment",
        "codexHomeEqualsHomeDotCodex",
        "freshCodexProcessPerVerification",
        "sharedMutableState",
        "forbiddenHostInputs",
        "forbiddenAttachments"
      ],
      "properties": {
        "runRootTemplate": {
          "const": "/var/lib/nelos-validator/runs/${RUN_ID}"
        },
        "laneRootTemplate": {
          "const": "${RUN_ROOT}/${LANE_ID}"
        },
        "environment": {
          "type": "object",
          "required": [
            "HOME",
            "CODEX_HOME",
            "TMPDIR",
            "XDG_CONFIG_HOME",
            "XDG_CACHE_HOME",
            "XDG_DATA_HOME"
          ],
          "properties": {
            "HOME": {
              "const": "${LANE_ROOT}/home"
            },
            "CODEX_HOME": {
              "const": "${LANE_ROOT}/home/.codex"
            },
            "TMPDIR": {
              "const": "${LANE_ROOT}/tmp"
            },
            "XDG_CONFIG_HOME": {
              "const": "${LANE_ROOT}/xdg/config"
            },
            "XDG_CACHE_HOME": {
              "const": "${LANE_ROOT}/xdg/cache"
            },
            "XDG_DATA_HOME": {
              "const": "${LANE_ROOT}/xdg/data"
            }
          },
          "additionalProperties": false
        },
        "codexHomeEqualsHomeDotCodex": {
          "const": true
        },
        "freshCodexProcessPerVerification": {
          "const": true
        },
        "sharedMutableState": {
          "const": false
        },
        "forbiddenHostInputs": {
          "type": "array",
          "items": {
            "enum": [
              "mac-authentication-state",
              "mac-codex-config",
              "mac-filesystem-mounts",
              "mac-plugin-cache",
              "ssh-agent-forwarding"
            ]
          },
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true
        },
        "forbiddenAttachments": {
          "type": "array",
          "items": {
            "enum": [
              "host-filesystem",
              "persistent-shared-cache",
              "persistent-shared-data-disk",
              "public-network-interface",
              "tpm-state",
              "usb-or-pci-passthrough"
            ]
          },
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "lanes": {
      "type": "object",
      "required": [
        "legacy-01446",
        "agent-plugin-01470"
      ],
      "properties": {
        "legacy-01446": {
          "$ref": "#/$defs/legacyLane"
        },
        "agent-plugin-01470": {
          "$ref": "#/$defs/agentPluginLane"
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "offline",
        "buildNetwork",
        "validationNetwork",
        "marketplaceSelector",
        "mcpServerId",
        "requiredChecks",
        "requiredObservations",
        "evidenceSchemaPath",
        "sanitization"
      ],
      "properties": {
        "offline": {
          "const": true
        },
        "buildNetwork": {
          "const": "allowlisted"
        },
        "validationNetwork": {
          "const": "denied"
        },
        "marketplaceSelector": {
          "const": "nelos@nelos-marketplace"
        },
        "mcpServerId": {
          "const": "nelos"
        },
        "requiredChecks": {
          "type": "array",
          "items": {
            "enum": [
              "marketplace-install",
              "plugin-install",
              "fresh-process-start",
              "mcp-initialize",
              "tools-list",
              "nelos-config-get",
              "lane-parity"
            ]
          },
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true
        },
        "requiredObservations": {
          "type": "array",
          "items": {
            "const": "network-denied-during-validation"
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "evidenceSchemaPath": {
          "const": "./evidence/schema.json"
        },
        "sanitization": {
          "type": "object",
          "required": [
            "required",
            "fullEnvironmentAllowed",
            "fullConfigurationAllowed",
            "credentialMaterialAllowed",
            "userSpecificIdentifiersAllowed",
            "allowedEnvironmentKeys"
          ],
          "properties": {
            "required": {
              "const": true
            },
            "fullEnvironmentAllowed": {
              "const": false
            },
            "fullConfigurationAllowed": {
              "const": false
            },
            "credentialMaterialAllowed": {
              "const": false
            },
            "userSpecificIdentifiersAllowed": {
              "const": false
            },
            "allowedEnvironmentKeys": {
              "type": "array",
              "items": {
                "enum": [
                  "CODEX_HOME",
                  "HOME",
                  "TMPDIR",
                  "XDG_CACHE_HOME",
                  "XDG_CONFIG_HOME",
                  "XDG_DATA_HOME",
                  "NELOS_PLUGIN_VERSION",
                  "NELOS_RELEASE_BUILD_IDENTITY",
                  "PLUGIN_DATA",
                  "PLUGIN_ROOT"
                ]
              },
              "minItems": 10,
              "maxItems": 10,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "required": [
        "activeGeneration",
        "replacedGenerationMinimumDays",
        "minimumValidatedGenerations",
        "disposableArtifacts"
      ],
      "properties": {
        "activeGeneration": {
          "const": "indefinite"
        },
        "replacedGenerationMinimumDays": {
          "const": 30
        },
        "minimumValidatedGenerations": {
          "const": 2
        },
        "disposableArtifacts": {
          "const": "destroy-after-reconciliation"
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": [
        "sourceDistribution",
        "templateMutation",
        "clonePerRun",
        "destroyAfterEvidenceExport",
        "sourceControlled",
        "forbiddenRepositoryArtifacts"
      ],
      "properties": {
        "sourceDistribution": {
          "const": "recipe-and-manifest-only"
        },
        "templateMutation": {
          "const": "immutable"
        },
        "clonePerRun": {
          "const": true
        },
        "destroyAfterEvidenceExport": {
          "const": true
        },
        "sourceControlled": {
          "type": "array",
          "items": {
            "enum": [
              "contract",
              "contract-schema",
              "cloud-init-policy",
              "ci-validation",
              "example-configuration",
              "evidence-schema",
              "lifecycle-scripts",
              "offline-validator",
              "operator-guide",
              "packer-template",
              "tests",
              "toolchain-lock"
            ]
          },
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true
        },
        "forbiddenRepositoryArtifacts": {
          "type": "array",
          "items": {
            "enum": [
              "auth-material",
              "cloud-init-instance-data",
              "codex-home",
              "disk-images",
              "generated-host-identity",
              "plugin-cache",
              "private-keys",
              "terraform-state",
              "unredacted-evidence"
            ]
          },
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "legacyLane": {
      "type": "object",
      "required": [
        "codexVersion",
        "pluginFormat",
        "pluginManifestPath",
        "mcpManifestPath",
        "launchMode",
        "pluginRootSource",
        "requiredEnvironment",
        "forbiddenAssumptions"
      ],
      "properties": {
        "codexVersion": {
          "const": "0.144.6"
        },
        "pluginFormat": {
          "const": "legacy-codex"
        },
        "pluginManifestPath": {
          "const": ".codex-plugin/plugin.json"
        },
        "mcpManifestPath": {
          "const": ".mcp.json"
        },
        "launchMode": {
          "const": "inline-home-cache-bootstrap"
        },
        "pluginRootSource": {
          "const": "home-dot-codex-cache-discovery"
        },
        "requiredEnvironment": {
          "type": "array",
          "items": {
            "enum": [
              "HOME",
              "CODEX_HOME",
              "TMPDIR",
              "XDG_CONFIG_HOME",
              "XDG_CACHE_HOME",
              "XDG_DATA_HOME"
            ]
          },
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true
        },
        "forbiddenAssumptions": {
          "type": "array",
          "items": {
            "enum": [
              "PLUGIN_DATA",
              "PLUGIN_ROOT"
            ]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "agentPluginLane": {
      "type": "object",
      "required": [
        "codexVersion",
        "pluginFormat",
        "pluginManifestPath",
        "mcpManifestPath",
        "launchMode",
        "pluginRootSource",
        "requiredEnvironment",
        "forbiddenAssumptions"
      ],
      "properties": {
        "codexVersion": {
          "const": "0.147.0"
        },
        "pluginFormat": {
          "const": "agent-plugin-v1"
        },
        "pluginManifestPath": {
          "const": "plugin.json"
        },
        "mcpManifestPath": {
          "const": "mcp.json"
        },
        "launchMode": {
          "const": "direct-plugin-root"
        },
        "pluginRootSource": {
          "const": "injected-plugin-environment"
        },
        "requiredEnvironment": {
          "type": "array",
          "items": {
            "enum": [
              "HOME",
              "CODEX_HOME",
              "TMPDIR",
              "XDG_CONFIG_HOME",
              "XDG_CACHE_HOME",
              "XDG_DATA_HOME",
              "PLUGIN_ROOT",
              "PLUGIN_DATA"
            ]
          },
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true
        },
        "forbiddenAssumptions": {
          "type": "array",
          "items": {
            "const": "legacy-cache-scan"
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
