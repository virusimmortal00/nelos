#!/usr/bin/env bash
set -euo pipefail
umask 077

readonly production_root=/
readonly fake_marker_bytes='nelos-credential-boundary-fake-v1'
execution_root="${NELOS_CREDENTIAL_BOUNDARY_ROOT:-${production_root}}"
test_mode="${NELOS_CREDENTIAL_BOUNDARY_TEST_MODE:-0}"

die() { printf '%s\n' "$1" >&2; exit "${2:-77}"; }
path_at() { if [[ ${execution_root} == / ]]; then printf '%s' "$1"; else printf '%s%s' "${execution_root}" "$1"; fi; }
metadata() {
  if stat -c '%u:%g:%a:%h:%s' "$1" >/dev/null 2>&1; then stat -c '%u:%g:%a:%h:%s' "$1"; else stat -f '%u:%g:%Lp:%l:%z' "$1"; fi
}

if [[ ${execution_root} == / ]]; then
  [[ ${EUID} -eq 0 && ${test_mode} == 0 ]] || die "credential boundary requires production root" 70
  PATH=/usr/sbin:/usr/bin:/sbin:/bin
else
  [[ ${test_mode} == 1 && ${execution_root} == /* && ${execution_root} != / && -d ${execution_root} && ! -L ${execution_root} ]] || die "credential boundary test root is invalid" 70
  IFS=: read -r root_uid root_gid root_mode _root_links _root_size <<<"$(metadata "${execution_root}")"
  [[ ${root_uid} == "${EUID}" && ${root_gid} == "$(id -g)" && ${root_mode} == 700 ]] || die "credential boundary test root metadata is unsafe" 70
  marker="${execution_root}/.nelos-credential-boundary-fake-root"
  [[ -f ${marker} && ! -L ${marker} && $(<"${marker}") == "${fake_marker_bytes}" ]] || die "credential boundary test root marker is invalid" 70
  IFS=: read -r marker_uid marker_gid marker_mode marker_links marker_size <<<"$(metadata "${marker}")"
  [[ ${marker_uid} == "${EUID}" && ${marker_gid} == "$(id -g)" && ${marker_mode} == 600 && ${marker_links} == 1 && ${marker_size} == 34 ]] || die "credential boundary test root marker metadata is unsafe" 70
  fake_bin="${execution_root}/.nelos-credential-boundary-bin"
  [[ -d ${fake_bin} && ! -L ${fake_bin} ]] || die "credential boundary fake command root is unavailable" 70
  PATH="${fake_bin}:/usr/bin:/bin"
fi
export PATH

for command in findmnt flock jq mount python3 sha256sum stat swapon systemctl umount; do command -v "${command}" >/dev/null || die "credential boundary dependency is unavailable: ${command}" 70; done
[[ $# -eq 1 && $1 =~ ^(prepare|attest|scrub)$ ]] || die "credential boundary requires one allowlisted operation" 64
readonly operation=$1
readonly binding_file="$(path_at /etc/nelos-desktop/run-binding.json)"
readonly state_root="$(path_at /var/lib/nelos-desktop)"
readonly boundary_file="${state_root}/credential-boundary.json"
readonly scrub_file="${state_root}/credential-scrub.json"
readonly codex_home="$(path_at /home/nelosauto/.codex)"
readonly runtime_auth_dir="$(path_at /run/nelos-desktop/auth)"
readonly auth_receipt="${state_root}/device-auth.json"
readonly gui_receipt="${state_root}/gui-ready.json"
readonly boot_id_file="$(path_at /proc/sys/kernel/random/boot_id)"
readonly expected_root_uid="$([[ ${execution_root} == / ]] && printf 0 || printf '%s' "${EUID}")"
readonly expected_root_gid="$([[ ${execution_root} == / ]] && printf 0 || id -g)"

assert_regular() {
  local path=$1 owner=$2 group=$3 mode=$4 maximum=$5 details
  [[ -f ${path} && ! -L ${path} ]] || die "unsafe credential-boundary file: ${path}"
  details="$(metadata "${path}")" || die "credential-boundary file metadata is unavailable"
  IFS=: read -r actual_owner actual_group actual_mode actual_links actual_size <<<"${details}"
  [[ ${actual_owner} == "${owner}" && ${actual_group} == "${group}" && ${actual_mode} == "${mode}" && ${actual_links} == 1 && ${actual_size} -ge 2 && ${actual_size} -le ${maximum} ]] || die "credential-boundary file metadata is unsafe: ${path} (observed ${actual_owner}:${actual_group}:${actual_mode}:${actual_links}:${actual_size})"
}

assert_directory() {
  local path=$1 owner=$2 group=$3 mode=$4 details
  [[ -d ${path} && ! -L ${path} ]] || die "unsafe credential-boundary directory: ${path}"
  details="$(metadata "${path}")" || die "credential-boundary directory metadata is unavailable"
  IFS=: read -r actual_owner actual_group actual_mode _actual_links _actual_size <<<"${details}"
  [[ ${actual_owner} == "${owner}" && ${actual_group} == "${group}" && ${actual_mode} == "${mode}" ]] || die "credential-boundary directory metadata is unsafe: ${path}"
}

fsync_path() {
  python3 - "$1" <<'PY'
import os, stat, sys
flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
fd = os.open(sys.argv[1], flags)
try:
    if not (stat.S_ISREG(os.fstat(fd).st_mode) or stat.S_ISDIR(os.fstat(fd).st_mode)):
        raise RuntimeError("unsupported fsync target")
    os.fsync(fd)
finally:
    os.close(fd)
PY
}

publish_root_json() {
  local destination=$1 bytes=$2 directory temporary
  directory="$(dirname -- "${destination}")"
  temporary="$(mktemp "${directory}/.$(basename -- "${destination}").XXXXXXXX")"
  printf '%s\n' "${bytes}" >"${temporary}"
  [[ ${execution_root} != / ]] || chown root:root "${temporary}"
  chmod 0440 "${temporary}"
  assert_regular "${temporary}" "${expected_root_uid}" "${expected_root_gid}" 440 16384
  fsync_path "${temporary}"
  mv -f "${temporary}" "${destination}"
  fsync_path "${directory}"
}

assert_regular "${binding_file}" "${expected_root_uid}" "${expected_root_gid}" 440 16384
binding="$(jq -ce '
  select(
    keys == ["automationUser","fencingToken","gatewayId","hostId","imageId","leaseId","macAddress","networkId","networkPolicyDigest","providerId","runId","stateRoot","vmId"] and
    .automationUser == "nelosauto" and .providerId == "proxmox-lab" and .hostId == "prox2" and .gatewayId == "9023" and .networkId == "nelosbld" and .gatewayId != .vmId and
    (.vmId | type == "string" and test("^[1-9][0-9]{2,8}$")) and
    (.macAddress | type == "string" and test("^02(:[0-9A-F]{2}){5}$")) and
    (.networkPolicyDigest | type == "string" and test("^sha256:[0-9a-f]{64}$")) and
    (.stateRoot == ("/var/lib/nelos-desktop/runs/" + .runId))
  )
' "${binding_file}")" || die "credential boundary run binding is invalid"
binding="$(jq -cS . <<<"${binding}")"
readonly binding
readonly run_id="$(jq -r .runId <<<"${binding}")"
readonly fencing_token="$(jq -r .fencingToken <<<"${binding}")"
readonly vm_id="$(jq -r .vmId <<<"${binding}")"
readonly image_id="$(jq -r .imageId <<<"${binding}")"
if [[ ${execution_root} == / ]]; then
  uid="$(id -u nelosauto)"; gid="$(id -g nelosauto)"
  [[ ${uid} -ge 1000 && ${gid} -ge 1000 ]] || die "automation account identity is unsafe"
else
  uid=${EUID}; gid=$(id -g)
fi
readonly uid gid

mkdir -p "${state_root}" "$(dirname -- "${codex_home}")" "$(dirname -- "${runtime_auth_dir}")"
[[ ${execution_root} != / ]] || chown root:root "${state_root}" "$(dirname -- "${runtime_auth_dir}")"
chmod 0750 "${state_root}"
chmod 0755 "$(dirname -- "${runtime_auth_dir}")"
if [[ ! -e ${codex_home} && ! -L ${codex_home} ]]; then
  install -d -o "${uid}" -g "${gid}" -m 0700 "${codex_home}"
fi
assert_directory "${codex_home}" "${uid}" "${gid}" 700

lock_root="$(path_at /run/lock/nelos-credential-boundary)"
mkdir -p "${lock_root}"
chmod 0700 "${lock_root}"
exec 9<"${lock_root}"
flock -w 10 9 || die "another credential-boundary operation exceeded its bound" 75

assert_swap_disabled() {
  local swap_output proc_swaps
  swap_output="$(swapon --noheadings --show=NAME 2>/dev/null)" || die "active swap inventory is unavailable"
  [[ -z ${swap_output} ]] || die "active swap would persist credential pages"
  proc_swaps="$(path_at /proc/swaps)"
  [[ -f ${proc_swaps} && ! -L ${proc_swaps} ]] || die "kernel swap inventory is unavailable"
  [[ $(awk 'NR > 1 && NF > 0 { count += 1 } END { print count + 0 }' "${proc_swaps}") == 0 ]] || die "kernel reports active swap"
}

mount_observation() {
  findmnt --noheadings --raw --output TARGET,SOURCE,FSTYPE,OPTIONS --target "${codex_home}" 2>/dev/null
}

assert_tmpfs() {
  local observation target source fs options
  observation="$(mount_observation)" || die "volatile CODEX_HOME mount is unavailable"
  [[ -n ${observation} && ${observation} != *$'\n'* ]] || die "volatile CODEX_HOME mount observation is ambiguous"
  read -r target source fs options <<<"${observation}"
  [[ ${target} == "${codex_home}" && ${source} == "nelos-codex-${run_id}" && ${fs} == tmpfs ]] || die "CODEX_HOME is not the exact run-scoped tmpfs"
  for option in rw nosuid nodev noexec; do [[ ,${options}, == *,${option},* ]] || die "volatile CODEX_HOME mount option is missing: ${option}"; done
  assert_directory "${codex_home}" "${uid}" "${gid}" 700
}

boundary_unsigned() {
  local boot_digest
  [[ -f ${boot_id_file} && ! -L ${boot_id_file} ]] || die "kernel boot identity is unavailable"
  boot_digest="sha256:$(sha256sum "${boot_id_file}" | awk '{print $1}')"
  jq -cnS --arg runId "${run_id}" --arg fencingToken "${fencing_token}" --arg vmId "${vm_id}" \
    --arg imageId "${image_id}" --arg codexHome "/home/nelosauto/.codex" --arg bootIdDigest "${boot_digest}" '{
      schemaVersion:1,
      type:"nelos.credential-volatility.v1",
      runId:$runId,
      fencingToken:$fencingToken,
      vmId:$vmId,
      imageId:$imageId,
      codexHome:$codexHome,
      filesystemType:"tmpfs",
      mountOptions:["nodev","noexec","nosuid","rw"],
      swapActive:false,
      volatile:true,
      bootIdDigest:$bootIdDigest,
      secretBytesIncluded:false
    }'
}

attestation_for() {
  local unsigned=$1 digest
  digest="sha256:$(printf '%s\n' "${unsigned}" | sha256sum | awk '{print $1}')"
  jq -cS --argjson value "${unsigned}" --arg attestationDigest "${digest}" '$value + {attestationDigest:$attestationDigest}' <<<"{}"
}

validate_boundary_receipt() {
  assert_regular "${boundary_file}" "${expected_root_uid}" "${expected_root_gid}" 440 16384
  local expected
  expected="$(attestation_for "$(boundary_unsigned)")"
  [[ $(jq -cS . "${boundary_file}") == "${expected}" ]] || die "credential-boundary attestation differs from this run, fence, VM, image, or boot"
}

case "${operation}" in
  prepare)
    [[ ! -e ${scrub_file} && ! -L ${scrub_file} ]] || die "a scrubbed one-run credential boundary cannot be reopened"
    assert_swap_disabled
    if ! mount_observation >/dev/null 2>&1; then
      [[ -z $(find "${codex_home}" -mindepth 1 -maxdepth 1 -print -quit) ]] || die "persistent CODEX_HOME content exists beneath the volatile mount"
      mount -t tmpfs -o "rw,nosuid,nodev,noexec,size=64m,mode=0700,uid=${uid},gid=${gid}" "nelos-codex-${run_id}" "${codex_home}"
    fi
    assert_tmpfs
    if [[ -e ${boundary_file} || -L ${boundary_file} ]]; then validate_boundary_receipt; else publish_root_json "${boundary_file}" "$(attestation_for "$(boundary_unsigned)")"; fi
    jq -cS . "${boundary_file}"
    ;;
  attest)
    assert_swap_disabled
    assert_tmpfs
    validate_boundary_receipt
    jq -cS . "${boundary_file}"
    ;;
  scrub)
    if [[ -e ${boundary_file} || -L ${boundary_file} ]]; then validate_boundary_receipt; fi
    systemctl stop nelos-device-auth.service >/dev/null 2>&1 || true
    systemctl --user --machine="nelosauto@" stop nelos-codex-desktop.service >/dev/null 2>&1 || true
    if mount_observation >/dev/null 2>&1; then
      assert_tmpfs
      umount "${codex_home}"
    fi
    mount_observation >/dev/null 2>&1 && die "volatile CODEX_HOME remained mounted after scrub"
    [[ -z $(find "${codex_home}" -mindepth 1 -maxdepth 1 -print -quit) ]] || die "persistent CODEX_HOME content remains after scrub"
    for artifact in "${auth_receipt}" "${gui_receipt}" "${boundary_file}" "${runtime_auth_dir}"; do
      if [[ -d ${artifact} && ! -L ${artifact} ]]; then find "${artifact}" -xdev -mindepth 1 -delete; rmdir "${artifact}"; elif [[ -e ${artifact} || -L ${artifact} ]]; then unlink "${artifact}"; fi
    done
    scrub_unsigned="$(jq -cnS --arg runId "${run_id}" --arg fencingToken "${fencing_token}" --arg vmId "${vm_id}" '{
      schemaVersion:1,
      type:"nelos.credential-scrub.v1",
      runId:$runId,
      fencingToken:$fencingToken,
      vmId:$vmId,
      codexHome:"/home/nelosauto/.codex",
      credentialState:"absent",
      unmounted:true,
      reusableCredentialsAbsent:true,
      secretBytesIncluded:false
    }')"
    publish_root_json "${scrub_file}" "$(attestation_for "${scrub_unsigned}")"
    jq -cS . "${scrub_file}"
    ;;
esac
