def fail(code):
    sys.stderr.write(json.dumps({"error": code}) + "\n"); sys.exit(70)
def walk(root, maximum=10000):
    stack=[root]; seen=0
    while stack:
        item=stack.pop(); seen += 1
        if seen > maximum: fail("ACCESSIBILITY_TREE_LIMIT")
        yield item
        try:
            for index in range(item.childCount-1, -1, -1): stack.append(item.getChildAtIndex(index))
        except Exception: pass
def complete_scan(root, maximum=MAXIMUM_SCAN_NODES):
    stack=[root]; values=[]
    while stack:
        item=stack.pop()
        if len(values) >= maximum: fail("ACCESSIBILITY_TREE_LIMIT")
        values.append(item)
        try:
            count=item.childCount
            if not isinstance(count,int) or count < 0: fail("ACCESSIBILITY_SCAN_INCOMPLETE")
            children=[item.getChildAtIndex(index) for index in range(count)]
            if any(child is None for child in children): fail("ACCESSIBILITY_SCAN_INCOMPLETE")
        except SystemExit: raise
        except Exception: fail("ACCESSIBILITY_SCAN_INCOMPLETE")
        stack.extend(reversed(children))
    return values
def complete_scan_index(root, maximum=MAXIMUM_SCAN_NODES):
    stack=[(root,None)]; values=[]; parents={}
    while stack:
        item,parent=stack.pop()
        if len(values) >= maximum: fail("ACCESSIBILITY_TREE_LIMIT")
        values.append(item); parents[id(item)]=parent
        try:
            count=item.childCount
            if not isinstance(count,int) or count < 0: fail("ACCESSIBILITY_SCAN_INCOMPLETE")
            children=[item.getChildAtIndex(index) for index in range(count)]
            if any(child is None for child in children): fail("ACCESSIBILITY_SCAN_INCOMPLETE")
        except SystemExit: raise
        except Exception: fail("ACCESSIBILITY_SCAN_INCOMPLETE")
        stack.extend((child,item) for child in reversed(children))
    return values,parents
def facts(item):
    try: role=item.getRoleName()
    except Exception: role="unknown"
    try: name=item.name or ""
    except Exception: name=""
    try: description=item.description or ""
    except Exception: description=""
    try: attrs=" ".join(item.getAttributes())
    except Exception: attrs=""
    return role.lower(), name, description, attrs
def strict_facts(item):
    try:
        role=item.getRoleName(); name=item.name or ""; description=item.description or ""; attrs=" ".join(item.getAttributes())
    except Exception: fail("ACCESSIBILITY_SCAN_INCOMPLETE")
    if not all(isinstance(value,str) for value in (role,name,description,attrs)): fail("ACCESSIBILITY_SCAN_INCOMPLETE")
    return role.lower(),name,description,attrs
def strict_attributes(item):
    try: values=item.getAttributes()
    except Exception: fail("ACCESSIBILITY_SCAN_INCOMPLETE")
    if not isinstance(values,(list,tuple)) or len(values) > 512 or any(not isinstance(value,str) or len(value) > 4096 for value in values): fail("ACCESSIBILITY_SCAN_INCOMPLETE")
    result={}
    for value in values:
        if ":" not in value: continue
        key,content=value.split(":",1)
        if not key or key in result: fail("ACCESSIBILITY_SCAN_INCOMPLETE")
        result[key]=content
    return result
def strict_state(item,state):
    try: return item.getState().contains(state)
    except Exception: fail("ACCESSIBILITY_SCAN_INCOMPLETE")
def indexed_children(scanned,parents):
