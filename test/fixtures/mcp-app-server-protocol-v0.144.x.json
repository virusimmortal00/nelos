{
  "source": "codex-cli 0.144.5 and Codex Desktop 0.144.6: codex app-server generate-json-schema --experimental",
  "compatibleCodexVersions": [
    "0.144.5",
    "0.144.6"
  ],
  "initialize": {
    "requiredResponseFields": [
      "codexHome",
      "platformFamily",
      "platformOs",
      "userAgent"
    ],
    "experimentalApi": true
  },
  "methods": {
    "thread/read": {
      "requiredParams": [
        "threadId"
      ],
      "optionalParams": [
        "includeTurns"
      ],
      "readOnly": true
    },
    "thread/name/set": {
      "requiredParams": [
        "name",
        "threadId"
      ],
      "optionalParams": [],
      "readOnly": false
    },
    "thread/resume": {
      "requiredParams": ["threadId"],
      "optionalParams": ["excludeTurns"],
      "readOnly": false
    },
    "thread/turns/list": {
      "requiredParams": ["threadId"],
      "optionalParams": ["cursor", "itemsView", "limit", "sortDirection"],
      "requiredResponseFields": [
        "data",
        "nextCursor",
        "data[].id",
        "data[].items[].clientId",
        "data[].status"
      ],
      "readOnly": true
    },
    "turn/start": {
      "requiredParams": ["input", "threadId"],
      "optionalParams": ["clientUserMessageId"],
      "requiredResponseFields": ["turn.id"],
      "readOnly": false
    },
    "turn/steer": {
      "requiredParams": ["expectedTurnId", "input", "threadId"],
      "optionalParams": ["clientUserMessageId"],
      "requiredResponseFields": ["turnId"],
      "readOnly": false
    },
    "thread/archive": {
      "requiredParams": ["threadId"],
      "optionalParams": [],
      "readOnly": false
    }
  },
  "threadStatus": {
    "types": [
      "notLoaded",
      "idle",
      "systemError",
      "active"
    ],
    "activeFlags": [
      "waitingOnApproval",
      "waitingOnUserInput"
    ]
  }
}
