#!/usr/bin/env node

import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

import {
  SemanticAdvisoryInfrastructureError,
  runSemanticAdvisoryV1,
} from "../src/semantic-advisory-runner.mjs";

function usage() {
  return `Usage: nelos-semantic-advisory --opt-in --input PATH --provider PATH --provider-config PATH

Run a separate, trusted semantic-advisory comparison over bounded evidence.
No provider module is loaded and no provider call is made without --opt-in.

Options:
  --opt-in                Explicitly authorize the configured provider call
  --input PATH            JSON containing deterministicReport and selectedEvidence
  --provider PATH         Module exporting compareSemanticAdvisory(request, context)
  --provider-config PATH  JSON containing providerId, model, credentialId, timeoutMs
  -h, --help              Show this help
`;
}

function takeValue(argv, index, option) {
  const value = argv[index + 1];
  if (!value || value.startsWith("-")) {
    throw new SemanticAdvisoryInfrastructureError(
      `semantic advisory: ${option} requires a value`,
      { code: "invalid-arguments" },
    );
  }
  return resolve(value);
}

export function parseSemanticAdvisoryArgs(argv) {
  const options = {
    help: false,
    inputPath: null,
    optIn: false,
    providerConfigurationPath: null,
    providerPath: null,
  };
  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index];
    if (argument === "-h" || argument === "--help") {
      options.help = true;
    } else if (argument === "--opt-in") {
      options.optIn = true;
    } else if (argument === "--input") {
      options.inputPath = takeValue(argv, index, argument);
      index += 1;
    } else if (argument === "--provider") {
      options.providerPath = takeValue(argv, index, argument);
      index += 1;
    } else if (argument === "--provider-config") {
      options.providerConfigurationPath = takeValue(argv, index, argument);
      index += 1;
    } else {
      throw new SemanticAdvisoryInfrastructureError(
        `semantic advisory: unknown option ${argument}`,
        { code: "invalid-arguments" },
      );
    }
  }
  return options;
}

async function readJson(path, label) {
  if (!path) {
    throw new SemanticAdvisoryInfrastructureError(
      `semantic advisory: ${label} is required`,
      { code: "invalid-arguments" },
    );
  }
  try {
    return JSON.parse(await readFile(path, "utf8"));
  } catch (error) {
    throw new SemanticAdvisoryInfrastructureError(
      `semantic advisory: ${label} could not be read as JSON: ${error.message}`,
      { code: "invalid-arguments", cause: error },
    );
  }
}

function errorReport(error, invoked = false) {
  return {
    schemaVersion: 1,
    section: "semantic-advisory",
    authority: "advisory-only",
    countsForCompatibility: false,
    invoked,
    status: "infrastructure-failure",
    observedAt: null,
    deterministicStatus: null,
    provider: null,
    evidence: [],
    findings: [],
    infrastructure: {
      code: error.code ?? "infrastructure-failure",
      summary: error.message,
    },
  };
}

export async function main(argv = process.argv.slice(2)) {
  let options;
  try {
    options = parseSemanticAdvisoryArgs(argv);
    if (options.help) {
      process.stdout.write(usage());
      return 0;
    }
    if (!options.optIn) {
      process.stdout.write(`${JSON.stringify(errorReport(
        new SemanticAdvisoryInfrastructureError(
          "semantic advisory: explicit --opt-in is required; no provider was loaded or called",
          { code: "explicit-opt-in-required" },
        ),
      ), null, 2)}\n`);
      return 2;
    }
    if (!options.providerPath || !options.providerConfigurationPath) {
      throw new SemanticAdvisoryInfrastructureError(
        "semantic advisory: --provider and --provider-config are required",
        { code: "invalid-arguments" },
      );
    }
    const input = await readJson(options.inputPath, "--input");
    const providerConfiguration = await readJson(
      options.providerConfigurationPath,
      "--provider-config",
    );
    const providerModule = await import(pathToFileURL(options.providerPath).href);
    const report = await runSemanticAdvisoryV1({
      optIn: true,
      provider: { compare: providerModule.compareSemanticAdvisory },
      providerConfiguration,
      deterministicReport: input.deterministicReport,
      selectedEvidence: input.selectedEvidence,
    });
    process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
    return report.status === "completed" ? 0 : 2;
  } catch (error) {
    process.stdout.write(`${JSON.stringify(errorReport(error), null, 2)}\n`);
    process.stderr.write(`nelos-semantic-advisory: ${error.message}\n`);
    return 2;
  }
}

const isMain = process.argv[1] &&
  resolve(process.argv[1]) === fileURLToPath(import.meta.url);
if (isMain) process.exitCode = await main();
