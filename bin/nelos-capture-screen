#!/usr/bin/env node
import {
  DEFAULT_SCREEN_CAPTURE_MAX_BYTES,
  captureDeveloperScreen,
} from "../src/dev-screen-capture.mjs";

const args = process.argv.slice(2);
const allowed = new Set(["--out-dir", "--display", "--max-bytes", "--label"]);

function usage() {
  return "usage: nelos-capture-screen --out-dir /absolute/evidence [--display 1] [--max-bytes 26214400] [--label codex]";
}

function parseOptions() {
  if (args.includes("--help")) return { help: true };
  const values = new Map();
  for (let index = 0; index < args.length; index += 2) {
    const name = args[index];
    const value = args[index + 1];
    if (!allowed.has(name) || value === undefined || value.startsWith("--") || values.has(name)) {
      throw new Error(`invalid or duplicate option: ${name ?? "<missing>"}`);
    }
    values.set(name, value);
  }
  if (!values.has("--out-dir")) throw new Error("--out-dir is required");
  return {
    outputDirectory: values.get("--out-dir"),
    display: values.has("--display") ? Number(values.get("--display")) : 1,
    maxBytes: values.has("--max-bytes") ? Number(values.get("--max-bytes")) : DEFAULT_SCREEN_CAPTURE_MAX_BYTES,
    label: values.get("--label") ?? "screen",
  };
}

try {
  const options = parseOptions();
  if (options.help) {
    process.stdout.write(`${usage()}\n`);
  } else {
    const result = await captureDeveloperScreen(options);
    process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
  }
} catch (error) {
  process.stderr.write(`${error.code ?? "INVALID_ARGUMENT"}: ${error.message}\n${usage()}\n`);
  process.exitCode = 2;
}
