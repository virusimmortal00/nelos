#!/usr/bin/env node

import { readFile } from "node:fs/promises";

import { startNelosMcpServer } from "../src/mcp-server.mjs";
import { executorMcpClientV1 } from "../src/executor-mcp-tools.mjs";

// Development and test entry for the bundled MCP server. Legacy installs
// reach the same module through the generated .mcp.json bootstrap; Agent
// Plugins v1 launches this entry point directly from the plugin root. See
// docs/mcp-tool-surface.md.

let serverVersion = "0.0.0-dev";
try {
  const metadata = JSON.parse(
    await readFile(new URL("../package.json", import.meta.url), "utf8"),
  );
  if (typeof metadata.version === "string") serverVersion = metadata.version;
} catch {
  // A missing package manifest only affects the reported version.
}

const args = process.argv.slice(2);
if (args.length && (args.length !== 2 || args[0] !== "--executor-endpoint")) {
  throw new Error("usage: nelos-mcp [--executor-endpoint <private-endpoint.json>]");
}
startNelosMcpServer({ serverVersion,
  ownedExecutorClient: args.length ? executorMcpClientV1(args[1]) : null });
