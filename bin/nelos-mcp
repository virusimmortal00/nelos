#!/usr/bin/env node

import { readFile } from "node:fs/promises";

import { startNelosMcpServer } from "../src/mcp-server.mjs";

// Development and test entry for the bundled MCP server. Installed plugins
// launch the same module through the generated .mcp.json bootstrap; see
// docs/mcp-tool-surface.md.

let serverVersion = "0.0.0-dev";
try {
  const metadata = JSON.parse(
    await readFile(new URL("../package.json", import.meta.url), "utf8"),
  );
  if (typeof metadata.version === "string") serverVersion = metadata.version;
} catch {
  // A missing package manifest only affects the reported version.
}

startNelosMcpServer({ serverVersion });
