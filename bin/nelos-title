#!/usr/bin/env node

import {
  DEFAULT_TIMEOUT_MS,
  openAppServerClient,
  parsePositiveInteger,
  parseWebTitle,
  renderWebTitle,
  resolveThreadId,
} from "../src/app-server-client.mjs";
import { resolveQueenMarked } from "../src/task-web.mjs";
import {
  patchTaskRegistryRecord,
  readWebRecord,
  withWebRegistryLock,
  writeWebRecord,
} from "../src/task-state.mjs";

function normalizedThreadStatus(value) {
  if (value && typeof value === "object") return normalizedThreadStatus(value.type);
  return String(value || "").replaceAll(/[_\s-]/g, "").toLowerCase();
}

function isArchivedThread(thread) {
  if (!thread || typeof thread !== "object") return false;
  if (thread.archivedAt || thread.archived === true) return true;
  return ["archived", "archive"].includes(normalizedThreadStatus(thread.status));
}

function printUsage() {
  process.stdout.write(`Usage:
  nelos-title set TITLE [options]
  nelos-title get [options]

Options:
  --thread-id ID    Task ID (defaults to CODEX_THREAD_ID)
  --socket PATH     Active app-server control socket
  --timeout-ms N    Request timeout in milliseconds (default: 15000)
  -h, --help        Show this help
`);
}

function parseArgs(argv) {
  const options = { positionals: [] };

  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index];
    if (argument === "-h" || argument === "--help") {
      options.help = true;
      continue;
    }
    if (argument === "set" || argument === "get") {
      if (options.command) throw new Error("supply only one command");
      options.command = argument;
      continue;
    }
    if (["--title", "--thread-id", "--socket", "--timeout-ms"].includes(argument)) {
      const value = argv[index + 1];
      if (value === undefined) throw new Error(`missing value for ${argument}`);
      index += 1;
      if (argument === "--title") options.title = value;
      if (argument === "--thread-id") options.threadId = value;
      if (argument === "--socket") options.socketPath = value;
      if (argument === "--timeout-ms") options.timeoutMs = value;
      continue;
    }
    if (argument.startsWith("-")) throw new Error(`unknown option: ${argument}`);
    options.positionals.push(argument);
  }

  if (options.help) return options;
  options.command = options.command || (options.title || options.positionals.length ? "set" : null);
  if (!options.command) throw new Error("a command is required: set or get");
  if (options.command === "get" && (options.title || options.positionals.length)) {
    throw new Error("get does not accept a title");
  }
  if (options.command === "set") {
    if (options.title && options.positionals.length) {
      throw new Error("supply the title either positionally or with --title, not both");
    }
    if (options.positionals.length > 1) throw new Error("title must be one quoted argument");
    options.title = options.title || options.positionals[0];
    if (!options.title?.trim()) throw new Error("set requires a non-empty title");
  }
  delete options.positionals;
  return options;
}

async function main() {
  const options = parseArgs(process.argv.slice(2));
  if (options.help) {
    printUsage();
    return;
  }

  const threadId = resolveThreadId(options.threadId);
  const timeoutMs = parsePositiveInteger(options.timeoutMs ?? DEFAULT_TIMEOUT_MS, "--timeout-ms");
  const client = await openAppServerClient({
    clientName: "nelos-title",
    clientTitle: "Nelos Title CLI",
    socketPath: options.socketPath,
    timeoutMs,
  });

  try {
    if (options.command === "get") {
      const result = await client.request("thread/read", {
        threadId,
        includeTurns: false,
      });
      const liveTitle = result?.thread?.name ?? null;
      process.stdout.write(`${JSON.stringify({ threadId, liveTitle })}\n`);
      return;
    }

    const liveTitle = await withWebRegistryLock(async () => {
      const webRecord = await readWebRecord(threadId);
      const activeWebRecord =
        webRecord && !webRecord.archivedAt ? webRecord : null;
      const parsedTitle = parseWebTitle(options.title);
      const before = await client.request("thread/read", {
        threadId,
        includeTurns: false,
      });
      if (!before?.thread) throw new Error(`task not found: ${threadId}`);
      if (isArchivedThread(before.thread)) {
        throw new Error(`task ${threadId} is archived and cannot be renamed`);
      }
      const queenMarked = resolveQueenMarked({
        requestedTitle: options.title,
        liveTitle: before.thread.name || "",
        webRecord: activeWebRecord,
      });
      const effectiveTitle =
        activeWebRecord &&
        (activeWebRecord.inboundWebId || activeWebRecord.outboundWebId)
          ? renderWebTitle({
              baseTitle: parsedTitle.baseTitle,
              inboundWebId: activeWebRecord.inboundWebId,
              outboundWebId: activeWebRecord.outboundWebId,
              queenMarked,
            })
          : queenMarked
            ? renderWebTitle({
                baseTitle: parsedTitle.baseTitle,
                queenMarked: true,
              })
            : options.title;
      await client.request("thread/name/set", { threadId, name: effectiveTitle });
      const result = await client.request("thread/read", {
        threadId,
        includeTurns: false,
      });
      if (result?.thread?.name !== effectiveTitle) {
        throw new Error(
          `title verification failed: requested ${JSON.stringify(effectiveTitle)}, received ${JSON.stringify(result?.thread?.name ?? null)}`,
        );
      }

      const baseTitle = parsedTitle.baseTitle;
      await patchTaskRegistryRecord(threadId, { title: effectiveTitle, baseTitle });
      if (activeWebRecord) {
        await writeWebRecord({
          ...activeWebRecord,
          baseTitle,
          queenMarked,
          renderedTitle: effectiveTitle,
          updatedAt: new Date().toISOString(),
        });
      }
      return effectiveTitle;
    });
    process.stdout.write(
      `${JSON.stringify({
        threadId,
        requestedTitle: options.title,
        liveTitle,
        verified: true,
      })}\n`,
    );
  } finally {
    client.close();
  }
}

main().catch((error) => {
  process.stderr.write(`nelos-title: ${error.message}\n`);
  process.exitCode = 1;
});
