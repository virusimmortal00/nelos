{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nelos": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/bin/nelos-mcp"
      ],
      "env": {
        "NELOS_PLUGIN_VERSION": "0.13.0",
        "NELOS_RELEASE_BUILD_IDENTITY": "nelos-release-v1:0.13.0"
      }
    }
  }
}
